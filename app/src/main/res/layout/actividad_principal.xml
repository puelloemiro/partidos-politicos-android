<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/bienvenido"
            android:textColor="@color/primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/titulo_menu"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Tarjeta de botones del menú principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@color/card_background"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btnMenuCrud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:onClick="irAGuardarPartido"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="@string/btn_menu_guardar_partido"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnMenuListar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:onClick="irAListarPartidos"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="@string/btn_menu_listar"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnMenuReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:drawableStart="@android:drawable/ic_menu_view"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:onClick="irAReportes"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="@string/btn_menu_reportes"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnMenuCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/color_danger"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:drawablePadding="12dp"
                android:gravity="center_vertical|start"
                android:onClick="cerrarSesion"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="@string/btn_menu_cerrar_sesion"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Indicador didáctico del sensor de proximidad -->
        <TextView
            android:id="@+id/tvInfoProximidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E3F2FD"
            android:gravity="center"
            android:padding="12dp"
            android:text="Sensor de proximidad activo: acerque su mano a la pantalla para probarlo."
            android:textColor="@color/primary_dark"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
